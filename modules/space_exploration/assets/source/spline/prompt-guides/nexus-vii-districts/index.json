  "originalityPolicy": {
    "referenceUse": "Genre references may inform hierarchy, readability, functional storytelling, combined-arms scale, and faction differentiation only.",
    "forbidden": [
      "copied geometry or layouts",
      "copied logos, faction marks, or UI plates",
      "derived copyrighted textures",
      "recognizable character, vehicle, or building replicas"
    ]
  },
  "commonModelingContract": {
    "units": "meters",
    "upAxis": "+Y",
    "forwardAxis": "+Z",
    "floorPlane": "y=0",
    "humanReferenceHeightM": 1.8,
    "minimumPersonnelDoorM": [1.25, 2.4],
    "minimumPublicCorridorWidthM": 2.4,
    "guardrailHeightM": 1.1,
    "maximumAccessibleRampSlope": "1:12",
    "requiredUVSets": [
      "UV0 authored for PBR bases, trim strips, and decals",
      "UV1 non-overlapping when supported by the authoring/export path"
    ],
    "requiredGeometryData": [
      "tangents",
      "correct animation pivots",
      "simple hidden collision proxies",
      "LOD0",
      "LOD1",
      "LOD2"
    ],
    "requiredFacilityStages": [
      "STAGE_empty",
      "STAGE_foundation",
      "STAGE_frame",
      "STAGE_machinery",
      "STAGE_complete",
      "STAGE_retrofit_lockout"
    ],
    "constructionPresentation": {
      "queued": "restrained holographic footprint using A05",
      "foundation": "authored utility foundation, survey marks, barriers, and service feeds",
      "frame": "district-specific structural frame, never generic cubes",
      "machinery": "partial functional installation with temporary service route",
      "complete": "clean commissioned facility with selected Tier identity",
      "retrofit": "old facility visibly locked out in amber while replacement stages progress",
      "powerPaused": "bounded A05 marker; progress geometry remains intact"
    },
    "export": {
      "format": "GLB",
      "include": [
        "named district root",
        "named Tier and facility roots",
        "named build stages",
        "shared material IDs",
        "collision proxies",
        "focus, entry, build, and animation anchors",
        "manifest of triangle counts, dimensions, pivots, materials, and stage visibility"
      ],
      "exclude": [
        "cameras",
        "baked environment or skybox",
        "runtime scripts",
        "unsupported procedural-only materials",
        "loose meshes outside the district root"
      ]
    }
  },
