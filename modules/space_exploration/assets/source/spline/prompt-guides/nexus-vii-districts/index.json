  "mobileAcceptance": {
    "primaryViewport": [430, 932],
    "camera": "tilted top-down cutaway",
    "requirements": [
      "district purpose recognizable with UI hidden",
      "hero silhouette, route mouths, Tier massing, and selected facility survive LOD2",
      "room remains visible when the phone inspector is collapsed",
      "no text-dependent facility differentiation",
      "no clipped, floating, mirrored, stretched, or z-fighting decals",
      "human, door, furniture, road, and machinery scale remain coherent"
    ]
