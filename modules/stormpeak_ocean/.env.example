# This example contains no credentials. Supply live values through the private
# server environment; never commit a populated .env or .env.local file.
# Offline/local tester mode may explicitly use the shared dev user.
VITE_AUTH_ENABLED=false

# To enable OAuth, set VITE_AUTH_ENABLED=true and inject all of these server-side:
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
BETTER_AUTH_URL=
