  "compositionContract": {
    "requiredKitCoverage": {
      "roads": ["straight", "corner", "t_junction", "x_junction_or_plaza", "gated_endcap", "primary_to_local_adapter"],
      "corridors": ["straight", "corner", "t_junction", "airlock_or_endcap"],
      "podiums": ["16x16", "32x32", "32x48"],
      "structures": ["two_low", "two_mid", "two_tall", "one_hero", "one_industrial_or_logistics"],
      "states": ["pristine", "damaged_light", "damaged_heavy_or_ruined", "infested_overlay_if_applicable"]
    },
    "determinism": {
      "seedFormula": "hash(worldSeed, planetId, regionId, siteId, districtIndex, plotIndex, kitVersion)",
