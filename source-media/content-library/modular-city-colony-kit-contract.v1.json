    "positionToleranceMeters": 0.005,
    "yawToleranceDegrees": 0.05,
    "socketGapToleranceMeters": 0.01,
    "rules": [
      "Module footprints must be integer multiples of 16 m except declared 4 m detail adapters.",
      "Socket centers must lie on the owning footprint boundary and on the 4 m detail grid.",
      "Runtime placement may translate on the 16 m grid and rotate by allowed yaw only; no arbitrary or non-uniform scaling.",
      "Road and corridor surfaces must meet without a vertical step larger than 0.02 m."
    ]
  },
