  "lodContract": {
    "tiers": [
      {
        "tier": "LOD0",
        "purpose": "close tactical and inspection",
        "maximumTrianglesByClass": {"transit": 3000, "corridor": 8000, "podium": 3000, "tower_small": 20000, "tower_medium": 40000, "hero": 80000, "set_dressing": 4000}
      },
      {
        "tier": "LOD1",
        "purpose": "normal tactical",
        "maximumTrianglesByClass": {"transit": 1400, "corridor": 3600, "podium": 1400, "tower_small": 9000, "tower_medium": 18000, "hero": 36000, "set_dressing": 1800}
      },
      {
        "tier": "LOD2",
        "purpose": "command zoom",
        "maximumTrianglesByClass": {"transit": 500, "corridor": 1200, "podium": 500, "tower_small": 3000, "tower_medium": 6000, "hero": 12000, "set_dressing": 500}
      },
      {
        "tier": "LOD3",
        "purpose": "strategic silhouette or approved impostor",
        "maximumTrianglesByClass": {"transit": 80, "corridor": 180, "podium": 80, "tower_small": 400, "tower_medium": 800, "hero": 1600, "set_dressing": 80}
      }
    ],
    "hysteresisPercent": 15,
    "requirements": [
      "Every approved structural asset supplies LOD0, LOD1, and LOD2; LOD3 may be a mesh or approved impostor.",
      "Socket planes, podium footprint, ground contact, height class, and primary silhouette stay invariant across LODs.",
      "LOD simplification removes micro-detail before roofline, entrance, faction marker, damage breach, or objective silhouette.",
      "Generated source meshes are SOURCE_CANDIDATE only until cameras/lights are removed, scale is normalized, topology is reduced, semantic material slots are bound, and all LOD evidence passes.",
      "LOD thresholds are screen-space driven with hysteresis; distance-only switching without capture evidence is rejected."
    ]
  },
  "collisionNavContract": {
    "namedRoots": {
      "render": "VIS_<assetId>_LOD<n>",
      "collision": "COLL_<assetId>_<index>",
      "navBlocker": "NAV_BLOCK_<assetId>_<index>",
      "navLink": "NAV_LINK_<assetId>_<socketId>",
      "occluder": "OCC_<assetId>_<index>"
    },
    "collisionRules": [
      "Render meshes are never used directly as gameplay collision.",
      "Static collision uses boxes, capsules, convex hulls, or authored low-poly compounds with at most 64 triangles per convex hull and at most 12 hulls per ordinary module.",
      "Collision stays inside the visible solid by 0.05 m to prevent snagging and may not enter a declared socket clearance.",
      "Damage variants preserve the base collision identifier unless they publish an explicit deterministic collision replacement.",
      "Set dressing smaller than 0.5 m has no gameplay collision unless tagged hard_cover."
    ],
    "navClasses": [
      {"classId": "infantry", "agentRadiusMeters": 0.45, "agentHeightMeters": 2.2, "minimumClearWidthMeters": 1.2, "maximumStepMeters": 0.4},
      {"classId": "light_vehicle", "agentRadiusMeters": 2.25, "agentHeightMeters": 4, "minimumClearWidthMeters": 5, "maximumStepMeters": 0.25},
      {"classId": "heavy_vehicle", "agentRadiusMeters": 4, "agentHeightMeters": 8, "minimumClearWidthMeters": 9, "maximumStepMeters": 0.2},
      {"classId": "superheavy", "agentRadiusMeters": 7, "agentHeightMeters": 12, "minimumClearWidthMeters": 15, "maximumStepMeters": 0.15}
    ],
    "navRules": [
      "Every road or corridor socket publishes a centered NAV_LINK using the same position and outward vector.",
      "Mated socket links must be coincident within 0.01 m, face opposite directions, and share at least one nav class.",
      "Road decoration, debris, props, ramps, and curb caps stay outside the profile clearance or publish an explicit blocked state.",
      "An entrance is valid only when a continuous path exists from its podium access socket to the district road graph.",
      "Ruined or infested states that change traversal publish a state-specific blocker and a deterministic reroute test."
    ]
  },
  "materialContract": {
    "semanticSlots": [
      {"slotId": "MAT_STRUCTURAL", "required": true, "usage": "load-bearing frame, ribs, structural metal or composite"},
      {"slotId": "MAT_FACADE", "required": true, "usage": "tileable primary wall or tower skin"},
      {"slotId": "MAT_ROOF", "required": true, "usage": "roof, maintenance deck, and exposed top surfaces"},
      {"slotId": "MAT_CONTACT", "required": true, "usage": "podium, curb, foundation, soil seal, and road transition"},
      {"slotId": "MAT_GLAZING", "required": false, "usage": "glass or pressure glazing; separate from opaque façade"},
      {"slotId": "MAT_EMISSIVE", "required": false, "usage": "windows, guidance, signs, and power status; restrained and mask-driven"},
      {"slotId": "MAT_DECAL", "required": false, "usage": "district, traffic, faction, safety, and function markings"},
      {"slotId": "MAT_DAMAGE", "required": false, "usage": "scorch, exposed structure, breach, and rubble transition"},
      {"slotId": "MAT_INFESTATION", "required": false, "usage": "Brood biomass overlay; never a playable-faction skin"}
    ],
    "rules": [
      "Geometry owns meaning; material swaps may adapt climate and faction but do not count as a new silhouette or new model.",
      "Facade, roof, contact, glazing, emission, damage, and infestation remain separately addressable.",
      "Tileable materials require 2K source, neutral lighting, matching tangent normal/roughness, four-way seam proof, 3x3 repeat proof, and mobile captures before approval.",
      "Exterior hull material is not a universal interior, road, podium, or city material.",
      "Emission uses a texture mask and post-process response; geometry glow shells are optional accents, not substitutes for emissive input."
    ]
  },
