# Keep large authored and runtime binary art out of ordinary Git history. New
# art is still versioned on the branch, while Git LFS carries the binary body.
*.glb filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.ktx2 filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text

# Markdown uses two trailing spaces for explicit CommonMark line breaks. PDFs
# remain ordinary Git objects so GitHub can render them, but are binary diffs.
*.md whitespace=-trailing-space,-blank-at-eof
*.pdf binary
