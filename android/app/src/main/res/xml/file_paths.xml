<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Share of a CACHE fallback save. -->
    <cache-path name="cache" path="." />
    <!-- App-private Filesystem DATA/LIBRARY paths. -->
    <files-path name="files" path="." />
    <external-files-path name="external_files" path="." />
    <!-- DOCUMENTS writes to public Documents/MASSFRONT/Saves. The previous
         external-path "." exposed the whole shared volume to FileProvider. -->
    <external-path name="documents" path="Documents/" />
</paths>
