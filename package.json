{
  "name": "massfront",
  "version": "1.33.31",
  "description": "MASSFRONT — a large-scale mobile RTS",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 8100",
    "bundle": "node tools/bundle.mjs",
    "pack": "node tools/pack-www.mjs",
    "towers:blender": "node tools/render-tower-lab.mjs",
    "android:sync": "npm run pack && npx cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "ios:sync": "npm run pack && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/share": "^8.0.1"
  }
}
